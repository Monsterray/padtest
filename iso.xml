<?xml version="1.0" encoding="utf-8"?>
<!-- mkpsxiso CD layout. Paths are relative to the build directory. -->
<iso_project>
	<track type="data">
		<identifiers
			system			="PLAYSTATION"
			volume			="PADTEST"
			volume_set		="PADTEST"
			publisher		="SHENDO_GGRTK"
			data_preparer	="PSN00BSDK ${PSN00BSDK_VERSION}"
			application		="PLAYSTATION"
			copyright		="README.TXT;1"
		/>
		<directory_tree>
			<file name="SYSTEM.CNF"		type="data" source="${PROJECT_SOURCE_DIR}/system.cnf" />
			<file name="PADTEST.EXE"	type="data" source="padtest.exe" />
			<dummy sectors="1024"/>
		</directory_tree>
	</track>
</iso_project>
